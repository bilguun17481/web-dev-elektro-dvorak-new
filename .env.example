# Copy to .env.local. Every variable the app reads is listed here.
# Nothing secret belongs in NEXT_PUBLIC_*; those reach the browser.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. The anon key is public by design; the service role key is not and is read
# only by the server, never by a client component.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payment gateways. None is signed yet; the adapter makes the first one swappable.
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
COMGATE_MERCHANT=
COMGATE_SECRET=

# Carriers. FOFR is booked separately and has no public shipment API.
BALIKOBOT_API_USER=
BALIKOBOT_API_KEY=

# Bank feed for matching transfers by variable symbol.
KB_API_KEY=

# Transactional email.
RESEND_API_KEY=

# Shared secret the LAN sync agent signs its batches with.
ERP_INGEST_SECRET=
