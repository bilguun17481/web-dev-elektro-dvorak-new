# Copy to .env.local. Every variable the app reads is listed here.
# Nothing secret belongs in NEXT_PUBLIC_*; those reach the browser.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin ────────────────────────────────────────────────────────────────────────────
# Encrypts carrier credentials at rest. Without it the admin refuses to store an API key.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=

# Signs the admin session cookie. Any long random string; at least 32 characters.
ADMIN_SESSION_SECRET=

# Local owner login, for working before Supabase exists. Opt-in on purpose: a deployment
# that does not set ADMIN_LOCAL_LOGIN cannot use this path at all. Remove all three
# before going live.
ADMIN_LOCAL_LOGIN=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Where the development store keeps admin settings. Defaults to .data/shop.json.
SHOP_DATA_FILE=

# ── Supabase ─────────────────────────────────────────────────────────────────────────
# The anon key is public by design; the service role key is not and is read only by the
# server, never by a client component.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Payment gateways ─────────────────────────────────────────────────────────────────
# None is signed yet; the adapter makes the first one swappable.
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
COMGATE_MERCHANT=
COMGATE_SECRET=

# ── Carriers ─────────────────────────────────────────────────────────────────────────
# Carrier credentials are NOT set here. They are entered in the admin under Doprava and
# stored encrypted, so adding a carrier needs no deploy and no environment change.

# ── Other ────────────────────────────────────────────────────────────────────────────
# Bank feed for matching transfers by variable symbol.
KB_API_KEY=
# Transactional email.
RESEND_API_KEY=
# Shared secret the LAN sync agent signs its batches with.
ERP_INGEST_SECRET=
